PKG_CPPFLAGS = -I../inst/include
PKG_CXXFLAGS = $(CXX_VISIBILITY)
PKG_LIBS = build/libopenvdbr_core.a build/libblosc.a -Lbuild/runtime -lopenvdbr_tbb -lz backend/openvdbr.def
OBJECTS = r_api.o
export OPENVDBR_CPPFLAGS = $(CPPFLAGS)
export OPENVDBR_LDFLAGS = $(LDFLAGS)
all: $(SHLIB)
$(SHLIB): backend
.PHONY: backend
backend:
	"$(R_HOME)/bin${R_ARCH_BIN}/Rscript.exe" --vanilla ../tools/build.R "$(CXX)" "$(ALL_CXXFLAGS)" "$(CC)" "$(ALL_CFLAGS)"
clean:
	rm -f $(OBJECTS) $(SHLIB)
	rm -rf build
