# Configuration is substituted by tools/configure.R before R invokes make.
PKG_CPPFLAGS = @NATIVE_CPPFLAGS@
PKG_CXXFLAGS = $(CXX_VISIBILITY)
PKG_LIBS = build/libopenvdb.a @BLOSC_LIBS@ @ZLIB_LIBS@ @TBB_LIBS@ @EXPORT_FLAGS@
CMAKE = @CMAKE@
BUILD_JOBS = @BUILD_JOBS@

all: $(SHLIB)

# R discovers and compiles all package sources. CMake builds vendored code only;
# let its dependency graph detect changes to upstream sources on every build.
$(OBJECTS) $(SHLIB): vendor
.PHONY: vendor
vendor:
	$(CMAKE) --build build --parallel $(BUILD_JOBS)

clean:
	rm -f $(OBJECTS) $(SHLIB)
	$(CMAKE) --build build --target clean
