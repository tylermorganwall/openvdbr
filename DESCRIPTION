Package: openvdbr
Type: Package
Title: Sparse Volumes with an 'OpenVDB' Runtime Interface
Version: 13.1.0-2
Authors@R: c(
    person("Tyler", "Morgan-Wall", email = "tylermw@gmail.com",
        role = c("aut", "cre", "cph"),
        comment = c(ORCID = "0000-0002-3131-3814")),
    person("Contributors to the OpenVDB Project", role = c("ctb", "cph")),
